<% content_for :title, "Edit #{@course_domain.name}" %>
<% content_for :app_icon, "🏫" %>
<% content_for :app_title, "Course settings" %>
<% content_for :app_subtitle, @course_domain.name %>
<div class="mini-app-body hands-app">
  <%= render "admin/course_domains/form", form_url: course_path(@course_domain) %>

  <hr class="my-4">

  <h2 class="h6">Linking a course site</h2>
  <p class="text-muted small">
    Configure a course-site with this course's slug and link secret to embed the
    student widget. Any course-site holding the secret can create student tokens for
    this course.
  </p>
  <table class="table small">
    <tbody>
      <tr><th scope="row">Course slug</th><td><code><%= @course_domain.slug %></code></td></tr>
      <tr><th scope="row">Link secret</th><td><code><%= @course_domain.link_secret %></code></td></tr>
    </tbody>
  </table>
  <%= button_to "Rotate link secret", rotate_secret_course_path(@course_domain),
        method: :post, class: "btn btn--outline-warning",
        data: { turbo_confirm: "Rotating breaks every linked course-site until they are reconfigured. Continue?" } %>
</div>

<div class="mini-app-footer">
  <%= submit_tag "Save changes", class: "action primary", form: "course_domain_form" %>
</div>
