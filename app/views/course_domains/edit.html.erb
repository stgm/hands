<% content_for :title, "Edit #{@course_domain.name}" %>
<% content_for :app_icon, "🏫" %>
<% content_for :app_title, "Course settings" %>
<% content_for :app_subtitle, @course_domain.name %>
<div class="mini-app-body hands-app">
  <%= render "admin/course_domains/form", form_url: course_path(@course_domain), compact: true %>
  <p class="hint">Ask an administrator to change anything else about this course.</p>
</div>

<div class="mini-app-footer">
  <%= submit_tag "Save changes", class: "action primary", form: "course_domain_form" %>
</div>
