<% content_for :title, "Staff — #{current_course_domain.name}" %>
<% content_for :app_icon, "👥" %>
<% content_for :app_title, "Staff" %>
<% content_for :app_subtitle, current_course_domain.name %>

<ul class="menu menu--staff mini-app-body" role="list">
  <% @staff.each do |member| %>
    <li>
      <div>
        <span class="list-item__title"><%= member.display_name %></span>
        <div class="small text-muted"><%= member.user.email %></div>
        <%= form_with url: domain_staff_member_path(current_course_domain.slug, member), method: :patch do |f| %>
          <%= f.select :role, Membership.roles.keys.map { |role| [ role.capitalize, role ] }, { selected: member.role }, onchange: "this.form.requestSubmit()" %>
        <% end %>
      </div>
      <%= button_to "Remove", domain_staff_member_path(current_course_domain.slug, member), method: :delete, class: "btn--outline-danger", form: { data: { turbo_confirm: "Remove #{member.display_name}?" } } %>
    </li>
  <% end %>

  <%# Invitations that have been sent but not accepted sit in the same list, so
      the page reads as one roster of people who are (or will be) staff. %>
  <% @pending.each do |invitation| %>
    <li>
      <div>
        <span class="list-item__title text-muted"><%= invitation.email %></span>
        <div class="small text-muted">Invited as <%= invitation.role %>, not accepted yet</div>
      </div>
      <%= button_to "Cancel", domain_staff_invitation_path(current_course_domain.slug, invitation), method: :delete, class: "btn--outline-danger",
            form: { data: { turbo_confirm: "Cancel the invitation to #{invitation.email}?" } } %>
    </li>
  <% end %>
</ul>

<div class="mini-app-footer">
  <%= link_to "Invite staff", new_domain_staff_invitation_path(current_course_domain.slug), class: "action primary" %>
</div>
