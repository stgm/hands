<% content_for :title, @course_domain.name %>
<% content_for :app_icon, "✋" %>
<% content_for :app_title, @course_domain.name %>
<% content_for :app_subtitle, acting_staff? ? "Staff" : "Assistance" %>

<% if current_membership || acting_staff? %>
  <nav class="mini-app-body" aria-label="<%= @course_domain.name %> menu">
    <ul class="menu" role="list" data-controller="menu">
      <%# Staff work from the queue, so their own "ask a question" entry sits
          below it; for a student it is the only thing on the menu. %>
      <% if current_membership && !acting_staff? %>
        <li><%= link_to "Ask a question", domain_hand_path(@course_domain.slug) %></li>
      <% end %>

      <% if acting_staff? %>
        <li><%= link_to "Invite link for students", domain_invite_path(@course_domain.slug) %></li>
        <li><%= link_to "Open the queue", domain_queue_hands_path(@course_domain.slug) %></li>
        <% if current_membership %>
          <li><%= link_to "Ask a question", domain_hand_path(@course_domain.slug) %></li>
        <% end %>
        <li><%= link_to "All students", domain_attendance_path(@course_domain.slug) %></li>
        <li><%= link_to "Recent notes", domain_notes_path(@course_domain.slug) %></li>
      <% end %>
    </ul>
  </nav>
  <%# Managing students, staff and course settings are administrative rather
      than day-to-day work, so they sit in the footer instead of the menu. %>
  <% if acting_staff? && (acting_senior? || @course_domain.managed_by?(current_user)) %>
    <div class="mini-app-footer">
      <% if acting_senior? %>
        <%= link_to "Students", domain_students_import_path(@course_domain.slug), class: "action" %>
        <%= link_to "Staff", domain_staff_path(@course_domain.slug), class: "action" %>
      <% end %>
      <% if @course_domain.managed_by?(current_user) %>
        <%= link_to "Settings", edit_course_path(@course_domain), class: "action" %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="mini-app-body hands-app">
    <div class="message">
      <% if @course_domain.enrollment_open? %>
        <h5>You are not a member of<br><%= @course_domain.name %> yet.</h5>
      <% else %>
        <h5>Enrollment is closed.<br><small class="text-muted">Use the widget in your course site, or ask a teacher.</small></h5>
      <% end %>
    </div>
  </div>
  <% if @course_domain.enrollment_open? %>
    <div class="mini-app-footer">
      <%= button_to "Join #{@course_domain.name}", domain_join_path(@course_domain.slug), method: :post, class: "action primary" %>
    </div>
  <% end %>
<% end %>
