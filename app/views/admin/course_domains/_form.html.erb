<%# `compact` asks only for the three things a teacher has to decide up front;
    the rest keeps its default (enrollment is open) and can be changed from the
    course settings afterwards. %>
<% compact = local_assigns.fetch(:compact, false) %>
<%# The submit button lives in the mini-app footer and reaches the form by id,
    the same way the sign-in form does. %>
<%= form_with model: @course_domain, url: form_url, id: "course_domain_form" do |f| %>
  <% if @course_domain.errors.any? %>
    <div class="alert alert--danger"><%= @course_domain.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :location_type, "Location label (e.g. room number, group)" %>
    <%= f.text_field :location_type %>
    <div class="hint">We ask students for a location. If you have multiple groups at the same time, your could ask for a room number. But if it makes sense, you could ask students to enter their group number.</div>
  </div>
  <div class="mb-3">
    <%= f.label :locale, "Language" %>
    <%= f.select :locale, I18n.available_locales.map { |l| [ l.to_s.upcase, l ] } %>
  </div>
  <% unless compact %>
    <div class="mb-3">
      <%= f.label :slug, "URL name" %>
      <%= f.text_field :slug %>
      <div class="hint">
        <% if @course_domain.persisted? %>
          The course is reached at /<%= @course_domain.slug %>. Changing this breaks existing links.
        <% end %>
        Leave empty to derive it from the name.
      </div>
    </div>

    <div class="field-check">
      <%= f.check_box :enrollment_open %>
      <%= f.label :enrollment_open, "Allow students to self-join via the domain link" %>
    </div>

    <fieldset class="field-group">
      <legend class="h6">Student widget</legend>
      <div class="field-check">
        <%= f.check_box :ask_location %>
        <%= f.label :ask_location, "Ask for a location when raising a hand" %>
      </div>
      <div class="field-check">
        <%= f.check_box :location_bumper %>
        <%= f.label :location_bumper, "Check students in (ask location before anything else)" %>
      </div>
      <div class="field-check">
        <%= f.check_box :link_mode %>
        <%= f.label :link_mode, "Ask for a Zoom link instead of a physical location" %>
      </div>
    </fieldset>
  <% end %>
<% end %>
