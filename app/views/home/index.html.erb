<% content_for :title, "Hands" %>
<% content_for :app_icon, "✋" %>
<% content_for :app_title, "Hands" %>
<% content_for :app_subtitle, current_user.display_name if logged_in? %>
<% content_for :no_header, true unless logged_in? %>

<% if logged_in? %>
  <nav class="mini-app-body" aria-label="Main menu">
    <%# The empty-list message differs per role, because the footer offers a
        different next step to admins and to teachers who may create a course. %>
    <% empty_variant = if current_user.admin?
                         "menu--courses-admin"
                       elsif current_user.may_create_course?
                         "menu--courses-creator"
                       else
                         "menu--courses-student"
                       end %>
    <ul class="menu menu--courses <%= empty_variant %>" role="list" data-controller="menu">
      <% @memberships.each do |membership| %>
        <% domain = membership.course_domain %>
        <li>
          <% if student_only?(membership) %>
            <%= link_to domain.name, domain_hand_path(domain.slug) %>
          <% else %>
            <%= link_to domain.name, domain_root_path(domain.slug) %>
          <% end %>
        </li>
      <% end %>

    </ul>
  </nav>
  <div class="mini-app-footer">
    <% if current_user.admin? %>
        <%= link_to "Manage domains", admin_course_domains_path, class: "action" %>
    <% elsif current_user.may_create_course? %>
        <%= link_to "Create a course", new_course_path, class: "action" %>
    <% end %>

    <%= button_to "Sign out", logout_path, method: :delete, class: "action danger",
          form: { data: { turbo_confirm: "Sign out?" } } %>
  </div>
<% else %>
  <div class="mini-app-body hands-app home-page">
    <div class="home-hero">
      <div class="home-hero-emoji">✋</div>
      <h5>Ask questions and get<br> help in class.</h5>
    </div>
  </div>
  <div class="mini-app-footer">
    <%= link_to "Sign in", auth_mail_login_path, class: "action primary" %>
  </div>
<% end %>
